{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orix-website",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "assets": {
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "orix.stifler.in",
      "custom_domain": true
    }
  ]
}
